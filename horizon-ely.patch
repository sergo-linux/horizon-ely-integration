+        let (line, body) = asked
+            .join()
+            .unwrap()
+            .split_once('\n')
+            .map(|(a, b)| (a.to_owned(), b.to_owned()))
+            .unwrap();
+        assert_eq!(line, "POST /session/join HTTP/1.1");
+        assert_eq!(
