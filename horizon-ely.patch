+}
+
+#[test]
+fn accounts_json_keeps_a_provider_only_for_ely() {
+    let accounts = Accounts {
+        accounts: vec![notch(), elyman()],
+        ..Accounts::default()
+    };
+    let text = serde_json::to_string(&accounts).unwrap();
+    assert_eq!(text.matches("\"provider\"").count(), 1);
